import numpy as np
arr=np.array([1,2,3,4])
print(arr[0],arr[-3])
##array and lists indexing is same 
print(arr[1:3],arr[:])
##slicing of reverse is not possible like from -1 to -3 but from -3 to -1 is possible
print(arr[::2])#every next two index
print(arr[::-1])#every -1 next its not like slicing
#fancy indexing
print(arr[0:3:2])##like for loop(initial increment final)
#stop at 3 means final value is 2